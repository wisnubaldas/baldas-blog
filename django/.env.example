# ─── Environment Variables Template ───────────────────────────────────────────
# Salin file ini menjadi .env untuk development lokal.
# Di Vercel Dashboard, tambahkan variabel-variabel ini pada menu Environment Variables.

# Django Secret Key
SECRET_KEY=your-secret-key-here

# Mode Debug (True untuk dev, False untuk production)
DEBUG=True

# Host & Origin
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Database ─────────────────────────────────────────────────────────────────
# Development lokal: kosongkan untuk menggunakan SQLite (db.sqlite3)
DATABASE_URL=

